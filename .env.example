# Proti IQ Environment Configuration Template
APP_ENV=development
LOG_LEVEL=INFO
API_PORT=8000
UI_PORT=8501

# Local SQLite (Development)
DATABASE_URL=sqlite:///./data/proti_iq.db

# Cloud Supabase PostgreSQL (Production)
SUPABASE_URL=https://dzbcefkvzufomdpfjmrw.supabase.co
SUPABASE_ANON_KEY=your_supabase_publishable_anon_key
SUPABASE_SERVICE_KEY=your_supabase_service_role_secret_key
SUPABASE_DB_URL=postgresql://postgres:[PASSWORD]@db.dzbcefkvzufomdpfjmrw.supabase.co:5432/postgres

# Security & CORS
ALLOWED_ORIGINS=["*"]
RATE_LIMIT_PER_MINUTE=120
SECRET_KEY=change_this_to_a_secure_random_string_in_production

# Cache & Offline Mode
OFFLINE_MODE=false
CACHE_DIR=./data/raw
