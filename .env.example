# Proti IQ Environment Configuration
APP_ENV=development
LOG_LEVEL=INFO
API_PORT=8000
UI_PORT=8501

# Database (SQLite for local dev, PostgreSQL for production Docker)
DATABASE_URL=sqlite:///./data/proti_iq.db

# Security & CORS
ALLOWED_ORIGINS=["http://localhost:8501","http://127.0.0.1:8501"]
RATE_LIMIT_PER_MINUTE=60
SECRET_KEY=change_this_to_a_secure_random_string_in_production

# Cache & Offline Mode
OFFLINE_MODE=false
CACHE_DIR=./data/raw
